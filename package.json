{
  "name": "flickity-mepto",
  "version": "2.3.0-mepto.1",
  "description": "Flickity 2.3.0 — Mepto-integrated, jQuery-free carousel. Drop-in, same Flickity API. Migrate legacy Shopify themes off jQuery.",
  "type": "module",
  "main": "dist/flickity.pkgd.js",
  "module": "dist/flickity.esm.js",
  "style": "dist/flickity.min.css",
  "exports": {
    ".": {
      "import": "./dist/flickity.esm.js",
      "require": "./dist/flickity.pkgd.js"
    },
    "./css": "./css/flickity.css",
    "./dist/flickity.css": "./css/flickity.css"
  },
  "files": [
    "dist",
    "src",
    "css",
    "README.md",
    "README.upstream.md"
  ],
  "browserslist": [
    "last 3 versions"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build && npm run build:min && npm run build:banner && npm run build:mepto",
    "build:min": "vite build --config vite.min.config.mjs",
    "build:banner": "node -e \"import fs from 'fs';const pkg=JSON.parse(fs.readFileSync('./package.json','utf8'));const b='/*! Flickity PACKAGED v2.3.0-mepto ('+pkg.version+') — Mepto-integrated, jQuery-free */\\n';['dist/flickity.esm.min.js','dist/flickity.pkgd.min.js'].forEach(f=>{let c=fs.readFileSync(f,'utf8');if(!c.startsWith('/*!')){fs.writeFileSync(f,b+c);console.log('banner',f)}})\"",
    "build:mepto": "npx esbuild node_modules/meptos/src/mepto.ts --bundle --format=iife --outfile=test/mepto.js",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "lint": "npx eslint src --ext .js",
    "test": "npx playwright test --reporter=list",
    "test:api": "npx playwright test test/flickity-api.spec.js --reporter=list"
  },
  "keywords": [
    "flickity",
    "carousel",
    "mepto",
    "zepto",
    "jquery-free",
    "shopify",
    "esm"
  ],
  "author": "Metafizzy (upstream) + oreoorbitz/flickity-mepto (mepto port)",
  "license": "GPL-3.0-or-Commercial",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oreoorbitz/flickity-mepto.git"
  },
  "homepage": "https://github.com/oreoorbitz/flickity-mepto#readme",
  "bugs": {
    "url": "https://github.com/oreoorbitz/flickity-mepto/issues"
  },
  "peerDependencies": {
    "meptos": ">=2.0.0"
  },
  "dependencies": {
    "desandro-matches-selector": "^2.0.0",
    "ev-emitter": "^1.1.1",
    "fizzy-ui-utils": "^2.0.7",
    "get-size": "^2.0.3",
    "unidragger": "^2.4.0",
    "unipointer": "^2.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.44.0",
    "@rollup/plugin-babel": "^7.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "terser": "^5.26.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
